---
layout: default
---
<link rel="stylesheet" href="{{ '/assets/css/cv.css' | relative_url | bust_file_cache }}">
<link rel="stylesheet" href="{{ '/assets/css/theme-colors.css' | relative_url }}">

{% assign cv_feature_enabled = site.al_folio.features.cv.enabled | default: true %}

{% if site.plugins contains 'al_folio_cv' and cv_feature_enabled %}
  {% capture rendered_cv %}{% al_folio_cv_render %}{% endcapture %}
  {% if page.cv_format == 'jsonresume' and site.data.resume.basics.linkedin and site.data.resume.basics.scholar %}
    {% capture profile_links %}
      <tr>
        <td class="p-1 pr-2 font-weight-bold"><b>Profiles</b></td>
        <td class="p-1 pl-2 font-weight-light">
          <a href="{{ site.data.resume.basics.linkedin }}">LinkedIn</a> ·
          <a href="{{ site.data.resume.basics.scholar }}">Google Scholar</a>
        </td>
      </tr>
    {% endcapture %}
    {% capture contact_info_end %}{{ profile_links }}</table>{% endcapture %}
    {{ rendered_cv | replace_first: '</table>', contact_info_end }}
  {% else %}
    {{ rendered_cv }}
  {% endif %}
{% else %}
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
      <p class="post-description">CV rendering is unavailable.</p>
    </header>
    <article>
      <p>Enable the <code>al_folio_cv</code> plugin and set <code>al_folio.features.cv.enabled: true</code> to render this page.</p>
    </article>
  </div>
{% endif %}
